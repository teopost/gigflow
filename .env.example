# Copia questo file in ".env" (stesso nome, senza ".example") e compila i
# valori per attivare il login con Google. Se ".env" non esiste o questi
# valori sono vuoti, l'app resta senza login, come è oggi.

# Da Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ALLOWED_EMAILS non serve più: l'accesso è aperto a qualsiasi account Google.
# Chi entra senza un link di invito trova un'app vuota e non vede i dati di
# nessun altro — è il workspace a fare da confine, non l'elenco degli indirizzi.
