# Copia questo file in ".env" (stesso nome, senza ".example") e compila i
# valori per attivare il login con Google. Se ".env" non esiste o questi
# valori sono vuoti, l'app resta senza login, come è oggi.

# Da Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ALLOWED_EMAILS non serve più: l'accesso è aperto a qualsiasi account Google.
# Chi entra senza un link di invito trova un'app vuota e non vede i dati di
# nessun altro — è il workspace a fare da confine, non l'elenco degli indirizzi.

# Elenco delle email che vedono la scheda "Admin", separate da virgola.
# Da lì si modificano i template (tipologie, categorie e modelli WhatsApp)
# con cui vengono precaricate le band nuove: sono impostazioni di questa
# installazione, non del singolo workspace. Se il valore è vuoto la scheda
# non compare a nessuno.
ADMIN_EMAILS=tuamail@gmail.com

# Notifiche su Telegram (facoltative). Il token lo da' BotFather quando crei
# il bot; la chat e' quella dove vuoi ricevere i messaggi — scrivi "/start"
# al bot e leggi l'id in https://api.telegram.org/bot<TOKEN>/getUpdates
# (in un gruppo l'id e' negativo). Se una delle due manca, non parte niente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# L'interruttore per farle tacere senza cancellare le due righe qui sopra.
# Vuoto o qualsiasi altro valore = accese. Si spegne con: no, off, 0, false.
TELEGRAM_ENABLED=yes

# Notifiche push sul telefono (facoltative). Non serve nessun account e
# nessun servizio di terzi: le due chiavi te le generi da solo, una volta
# sola, con l'immagine dell'app gia' costruita:
#
#   docker compose run --rm --entrypoint python3 gigflow -c \
#     "from py_vapid import Vapid01; from cryptography.hazmat.primitives import serialization as s; \
#      import base64; b=lambda x: base64.urlsafe_b64encode(x).decode().rstrip('='); \
#      v=Vapid01(); v.generate_keys(); \
#      print('VAPID_PRIVATE_KEY=' + b(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); \
#      print('VAPID_PUBLIC_KEY=' + b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)))"
#
# Le due righe che stampa si incollano qui sotto. Se le cambi, tutti i
# dispositivi gia' registrati smettono di ricevere e devono riaccendere il
# permesso: tienile nel backup del .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Il recapito che i servizi di consegna userebbero per avvisarti se questo
# server si mettesse a mandare messaggi a vanvera. Non viene verificato ne'
# registrato da nessuno. Se vuoto, l'app usa un segnaposto.
VAPID_SUBJECT=mailto:tuamail@gmail.com
